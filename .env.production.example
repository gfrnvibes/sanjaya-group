# Template .env PRODUCTION Sanjaya Konveksi.
# Salin ke server sebagai .env, isi bagian <...>, lalu: php artisan key:generate && php artisan config:cache
# Jangan commit file .env hasil isian (berisi password).

APP_NAME="Sanjaya Konveksi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain-aplikasi>

# Samakan dengan lokal (sudah dites); format angka Indonesia diatur di aplikasi.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log harian, simpan 14 hari; hanya warning ke atas.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sanjaya
DB_USERNAME=<user-db-khusus-aplikasi>
DB_PASSWORD=<password-db>
DB_TIMEZONE=Asia/Jakarta
# Lokasi pg_dump / pg_restore kalau tidak ada di PATH (untuk backup).
PG_DUMP_BINARY=pg_dump
PG_RESTORE_BINARY=pg_restore

# Sesi: cookie hanya lewat HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=sanjaya_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="<noreply@domain>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

IMPORT_MAX_ROWS=10000
IMPORT_MAX_BYTES=20971520

# Backup harian (jam 02:00 WIB) ke disk lokal + Cloudflare R2.
# Kosongkan R2_BUCKET untuk backup lokal saja (tidak disarankan di production).
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_RETENTION_DAYS=14
BACKUP_NAME=sanjaya-backup
BACKUP_DISKS=local,r2
BACKUP_MAIL_TO=<email-penerima-notifikasi-backup>
BACKUP_ARCHIVE_PASSWORD=<password-zip-backup>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_BUCKET=<r2-bucket>
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto

# Akun admin pertama (AdminSeeder). Ganti password setelah login pertama.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=<email-admin>
ADMIN_PASSWORD=<password-kuat>
